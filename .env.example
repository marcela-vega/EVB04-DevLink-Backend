# ============================================
# REQUERIDOS - Debes configurar estos valores
# ============================================

# PostgreSQL Database
DB_URL=jdbc:postgresql://localhost:5432/linkdev_db
DB_USERNAME=tu_usuario
DB_PASSWORD=tu_password

# JWT Secret (mínimo 32 caracteres)
JWT_SECRET=tu_jwt_secret_aqui_minimo_32_caracteres

# ============================================
# OPCIONALES - Tienen valores por defecto
# ============================================

# Docker Compose (solo si usas Docker local)
POSTGRES_DB=linkdev_db
POSTGRES_USER=tu_usuario
POSTGRES_PASSWORD=tu_password

# JPA / Hibernate (validate, update, create-drop)
JPA_DDL_AUTO=validate

# Server
SERVER_PORT=8080

# JWT Expiration (24 horas en milisegundos)
JWT_EXPIRATION_MS=86400000
